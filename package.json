{
	"name": "filament.zone",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint . && markdownlint 'publications/*.md' '.github/**/*.md'",
		"format": "prettier --plugin prettier-plugin-svelte --write '**/*' --ignore-unknown",
		"cms-gen": "tsx src/scripts/cms-gen.ts",
		"prepare": "husky",
		"prebuild": "npm run cms-gen",
		"preview:workers": "npm run build && wrangler dev",
		"preview:pages": "npm run build:pages && wrangler pages dev --cwd cloudflare/pages",
		"deploy:workers": "npm run build && wrangler deploy",
		"deploy:workers:preview": "npm run build && wrangler preview",
		"deploy:pages": "npm run build:pages && wrangler pages deploy --cwd cloudflare/pages",
		"cf:types": "wrangler types",
		"build:pages": "cross-env CF_PAGES=1 npm run build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261013.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/markdown-it": "^14.2.0",
		"@types/markdown-it-footnote": "^3.0.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.4",
		"cross-env": "^10.1.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"less": "^4.9.1",
		"markdown-toc": "^1.2.0",
		"markdownlint": "^0.41.1",
		"markdownlint-cli": "^0.49.1",
		"parse-md": "^3.0.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"svelte-preprocess": "^6.0.5",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"wrangler": "^4.150.0"
	},
	"type": "module",
	"dependencies": {
		"katex": "0.19.0",
		"markdown-it": "^15.0.2",
		"markdown-it-anchor": "^10.0.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-texmath": "^1.0.0",
		"moment": "^2.31.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*.ts"
	}
}
